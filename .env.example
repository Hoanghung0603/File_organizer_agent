# OpenRouter uses an OpenAI-compatible API.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4.1-mini
# OPENROUTER_MODEL must support tool calling.
# Optional. Defaults to OPENROUTER_MODEL and must support image input.
OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The organizer refuses targets outside this directory.
# Relative paths are resolved from the project directory.
FILE_ORGANIZER_ALLOWED_ROOT=.

# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=File Organizer Agent
